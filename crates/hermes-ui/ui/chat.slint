// Conversation column: virtualised transcript rows, tool-activity rows, composer.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Motion, Ease } from "theme.slint";
import { Icon, IconButton, Chip, Spinner, ShimmerText } from "components.slint";

export struct ToolRow {
    name: string,
    context: string,
    // 0 running, 1 done, 2 failed
    state: int,
    summary: string,
    output: string,
    added: int,
    removed: int,
    duration: string,
}

// One code/diff line. `md` is the line as styled text with syntax colours baked in.
export struct CodeLine {
    md: styled-text,
    // diff only: 0 context, 1 added, 2 removed, 3 hunk header, 4 note
    kind: int,
    old: string,
    new: string,
}

export struct TableCell {
    md: styled-text,
    // estimated column width (px); scaled down to fit the column
    w: length,
    // 0 left, 1 center, 2 right
    align: int,
}

export struct TableRow { cells: [TableCell] }

// A display segment of an assistant reply (rows.rs `segments`).
export struct Seg {
    // 0 prose, 1 code, 2 diff, 3 table, 4 prose-like fence (plain wrapped text)
    kind: int,
    md: styled-text,
    // code / diff / prose-fence source, for copy
    raw: string,
    lines: [CodeLine],
    header: TableRow,
    rows: [TableRow],
    total-w: length,
    added: int,
    removed: int,
    path: string,
}

export struct ChatRow {
    // 0 user, 1 assistant, 2 tools, 3 notice
    kind: int,
    text: string,
    segs: [Seg],
    reasoning: string,
    streaming: bool,
    error: bool,
    tools: [ToolRow],
    // Group label, e.g. "Ran 3 commands" / "Edited 2 files"
    tools-label: string,
    tools-running: bool,
    tools-added: int,
    tools-removed: int,
}

// Collapsible "Ran 3 commands >" group. Expand animates height + chevron rotation.
component ToolGroup inherits Rectangle {
    in property <ChatRow> item;
    in-out property <bool> expanded: false;
    property <length> body-h: expanded ? body.preferred-height : 0px;
    height: header.height + self.body-h;
    clip: true;
    animate body-h { duration: Motion.slow; easing: Ease.out; }

    header := Rectangle {
        y: 0;
        height: 30px;
        border-radius: Theme.r-sm;
        background: hdr-ta.has-hover ? Theme.hover : transparent;
        animate background { duration: Motion.fast; }
        HorizontalLayout {
            padding-left: 6px;
            spacing: 8px;
            alignment: start;
            if root.item.tools-running: Spinner { y: (parent.height - 14px) / 2; size: 14px; }
            if !root.item.tools-running: Image {
                y: (parent.height - 15px) / 2;
                width: 15px; height: 15px;
                source: root.item.tools-added + root.item.tools-removed > 0
                    ? @image-url("../../../assets/icons/file-pen.svg")
                    : @image-url("../../../assets/icons/terminal.svg");
                colorize: Theme.text-3;
            }
            if root.item.tools-running: ShimmerText { text: root.item.tools-label; font-size: Theme.fs-md; }
            if !root.item.tools-running: Text { text: root.item.tools-label; font-size: Theme.fs-md; color: Theme.text-3; vertical-alignment: center; }
            if root.item.tools-added > 0: Text { text: "+" + root.item.tools-added; color: Theme.success; font-size: Theme.fs-sm; font-family: Theme.mono-font; vertical-alignment: center; }
            if root.item.tools-removed > 0: Text { text: "-" + root.item.tools-removed; color: Theme.danger; font-size: Theme.fs-sm; font-family: Theme.mono-font; vertical-alignment: center; }
            Image {
                y: (parent.height - 14px) / 2;
                width: 14px; height: 14px;
                source: @image-url("../../../assets/icons/chevron-right.svg");
                colorize: Theme.text-3;
                transform-origin: { x: 7px, y: 7px };
                transform-rotation: root.expanded ? 90deg : 0deg;
                animate transform-rotation { duration: Motion.base; easing: Ease.out; }
            }
        }
        hdr-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expanded = !root.expanded; }
        }
        accessible-role: button;
        accessible-label: root.item.tools-label;
        accessible-expandable: true;
        accessible-expanded: root.expanded;
        accessible-action-expand => { root.expanded = !root.expanded; }
    }

    body := VerticalLayout {
        y: header.height + 4px;
        width: root.width;
        padding-left: 12px;
        spacing: 6px;
        opacity: root.expanded ? 1 : 0;
        animate opacity { duration: Motion.base; }
        for t in root.item.tools: Rectangle {
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.code-bg;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    if t.state == 0: Spinner { size: 12px; }
                    Text {
                        text: (t.name == "terminal" ? "$ " : t.name + "  ") + t.context;
                        font-family: Theme.mono-font;
                        font-size: Theme.fs-sm;
                        color: t.state == 2 ? Theme.danger : Theme.text-2;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if t.added > 0: Text { text: "+" + t.added; color: Theme.success; font-size: Theme.fs-xs; font-family: Theme.mono-font; }
                    if t.removed > 0: Text { text: "-" + t.removed; color: Theme.danger; font-size: Theme.fs-xs; font-family: Theme.mono-font; }
                    Text { text: t.duration; font-size: Theme.fs-xs; color: Theme.text-4; }
                }
                if t.output != "": Text {
                    text: t.output;
                    font-family: Theme.mono-font;
                    font-size: Theme.fs-xs + 0.5px;
                    color: Theme.text-3;
                    wrap: char-wrap;
                    max-lines: 14;
                    overflow: elide;
                }
            }
        }
    }
}

component ThinkingBlock inherits Rectangle {
    in property <string> text;
    in property <bool> live;
    in-out property <bool> open: false;
    property <length> body-h: open ? body.preferred-height + 6px : 0px;
    height: 26px + body-h;
    clip: true;
    animate body-h { duration: Motion.slow; easing: Ease.out; }
    HorizontalLayout {
        height: 26px;
        y: 0;
        spacing: 6px;
        alignment: start;
        if root.live: ShimmerText { text: "Thinking"; font-size: Theme.fs-sm + 0.5px; }
        if !root.live: Text { text: "Thought process"; font-size: Theme.fs-sm + 0.5px; color: Theme.text-3; vertical-alignment: center; }
        Image {
            y: (parent.height - 12px) / 2;
            width: 12px; height: 12px;
            source: @image-url("../../../assets/icons/chevron-right.svg");
            colorize: Theme.text-3;
            transform-origin: { x: 6px, y: 6px };
            transform-rotation: root.open ? 90deg : 0deg;
            animate transform-rotation { duration: Motion.base; easing: Ease.out; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
    }
    body := Rectangle {
        y: 30px;
        x: 0;
        width: root.width;
        height: self.preferred-height;
        Rectangle { x: 0; width: 2px; background: Theme.border-strong; border-radius: 1px; }
        t := Text {
            x: 12px;
            width: parent.width - 12px;
            text: root.text;
            wrap: word-wrap;
            color: Theme.text-3;
            font-size: Theme.fs-md;
        }
        preferred-height: t.preferred-height;
    }
}

// Copy button for a code card: 'Copy code', shows a check for a moment after copying.
component CopyButton inherits Rectangle {
    in property <string> label: "Copy code";
    in property <bool> shown;
    callback clicked();
    property <bool> done;
    width: 22px;
    height: 20px;
    border-radius: Theme.r-sm;
    background: ta.has-hover ? Theme.hover : transparent;
    opacity: root.shown || root.done || ta.has-hover ? 1 : 0;
    animate opacity { duration: Motion.fast; }
    Image {
        width: 12px; height: 12px;
        source: root.done ? @image-url("../../../assets/icons/check.svg") : @image-url("../../../assets/icons/copy.svg");
        colorize: ta.has-hover ? Theme.text : Theme.text-3;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); root.done = true; }
    }
    Timer { interval: 1500ms; running: root.done; triggered => { root.done = false; } }
    accessible-role: button;
    accessible-label: root.done ? "Copied" : root.label;
    accessible-action-default => { root.clicked(); root.done = true; }
}

// Fenced code / diff card (shiki-highlighter.tsx + code-card.tsx + expandable-block.tsx):
// a tinted slab with no border or header, copy button top-right on hover, body capped at
// 120 px with a bottom fade and an Expand/Collapse chevron when it overflows; expanded it
// grows to 40 % of the window and scrolls. Lines never wrap; wide code scrolls sideways.
component CodeBlock inherits Rectangle {
    in property <Seg> seg;
    in property <length> window-h: 900px;
    callback copy(string);
    property <bool> expanded;
    property <length> content-h: lines.preferred-height;
    property <bool> overflowing: root.content-h > 120px;
    property <length> cap: root.expanded ? max(121px, root.window-h * 0.4) : 120px;
    border-radius: 10px;
    background: Theme.code-bg;
    clip: true;
    height: min(root.content-h, root.cap);
    animate height { duration: Motion.base; easing: Ease.out; }

    hover := TouchArea { }

    flick := Flickable {
        width: root.width;
        height: root.height;
        content-width: max(root.width, lines.preferred-width);
        content-height: root.content-h;
        lines := VerticalLayout {
            width: flick.content-width;
            padding-top: 10px;
            padding-bottom: 10px;
            for l in root.seg.lines: Rectangle {
                background: l.kind == 1 ? Theme.diff-add-bg : l.kind == 2 ? Theme.diff-del-bg : l.kind == 3 ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    if root.seg.kind == 2: Text {
                        width: 28px;
                        text: l.old;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        font-family: Theme.mono-font;
                        font-size: Theme.fs-xs;
                        color: Theme.text-4;
                    }
                    if root.seg.kind == 2: Text {
                        width: 28px;
                        text: l.new;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        font-family: Theme.mono-font;
                        font-size: Theme.fs-xs;
                        color: Theme.text-4;
                    }
                    if root.seg.kind == 2: Text {
                        width: 10px;
                        text: l.kind == 1 ? "+" : l.kind == 2 ? "−" : "";
                        vertical-alignment: center;
                        font-family: Theme.mono-font;
                        font-size: Theme.fs-sm;
                        color: l.kind == 1 ? Theme.diff-add-fg : Theme.diff-del-fg;
                    }
                    StyledText {
                        text: l.md;
                        default-font-family: Theme.mono-font;
                        default-font-size: Theme.fs-sm;
                        default-color: l.kind >= 3 ? Theme.text-3 : Theme.text.with-alpha(0.9);
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Overflow cue: bottom fade + the only clickable target, a compact toggle at the right.
    if root.overflowing: Rectangle {
        y: root.height - 28px;
        height: 28px;
        background: @linear-gradient(0deg, Theme.code-bg 0%, Theme.code-bg.with-alpha(0) 100%);
        toggle := Rectangle {
            x: parent.width - 36px;
            width: 36px;
            Image {
                y: parent.height - 18px;
                width: 14px; height: 14px;
                source: @image-url("../../../assets/icons/chevron-down.svg");
                colorize: tta.has-hover ? Theme.text : Theme.text-3;
                transform-origin: { x: 7px, y: 7px };
                transform-rotation: root.expanded ? 180deg : 0deg;
                animate transform-rotation { duration: Motion.base; easing: Ease.out; }
            }
            tta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.expanded = !root.expanded; }
            }
            accessible-role: button;
            accessible-label: root.expanded ? "Collapse" : "Expand";
            accessible-expandable: true;
            accessible-expanded: root.expanded;
            accessible-action-default => { root.expanded = !root.expanded; }
        }
    }

    CopyButton {
        x: root.width - self.width - 16px;
        y: 6px;
        shown: hover.has-hover;
        clicked => { root.copy(root.seg.raw); }
    }
}

// GFM table: header row + hairline rules; columns sized from their widest cell and scaled
// to fit the column. (The original's draggable column sashes are not built yet.)
component TableBlock inherits Rectangle {
    in property <Seg> seg;
    property <float> scale: root.seg.total-w > 0 ? min(1, root.width / root.seg.total-w) : 1;
    height: body.preferred-height;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    body := VerticalLayout {
        Rectangle {
            background: Theme.hover;
            HorizontalLayout {
                alignment: start;
                for c in root.seg.header.cells: Rectangle {
                    width: c.w * root.scale;
                    height: ht.preferred-height + 14px;
                    ht := StyledText {
                        x: 10px;
                        width: parent.width - 20px;
                        text: c.md;
                        default-font-size: Theme.fs-md;
                        default-font-family: Theme.ui-font;
                        default-color: Theme.text;
                        horizontal-alignment: c.align == 1 ? center : c.align == 2 ? right : left;
                    }
                }
            }
        }
        for r in root.seg.rows: VerticalLayout {
            Rectangle { height: 1px; background: Theme.border; }
            HorizontalLayout {
                alignment: start;
                for c in r.cells: Rectangle {
                    width: c.w * root.scale;
                    height: ct.preferred-height + 14px;
                    ct := StyledText {
                        x: 10px;
                        width: parent.width - 20px;
                        text: c.md;
                        default-font-size: Theme.fs-md;
                        default-font-family: Theme.ui-font;
                        default-color: Theme.text-2;
                        link-color: Theme.link;
                        horizontal-alignment: c.align == 1 ? center : c.align == 2 ? right : left;
                    }
                }
            }
        }
    }
}

component MessageRow inherits Rectangle {
    in property <ChatRow> item;
    in property <int> transcript-mode; // 0 normal, 1 thinking, 2 verbose
    in property <length> column-w;
    in property <length> window-h;
    callback copy(string);

    // Fade+rise on insert (list item animate-in).
    property <float> appear: 0;
    init => { appear = 1; }
    opacity: appear;
    animate opacity { duration: Motion.base; easing: Ease.out; }

    height: lay.preferred-height;
    lay := VerticalLayout {
        x: (root.width - min(root.width - 48px, root.column-w)) / 2;
        width: min(root.width - 48px, root.column-w);
        padding-top: root.item.kind == 0 ? 18px : 6px;
        padding-bottom: 6px;
        spacing: 6px;

        // User bubble: right-aligned, surface background.
        if root.item.kind == 0: HorizontalLayout {
            alignment: end;
            Rectangle {
                max-width: lay.width * 0.82;
                border-radius: Theme.r-lg;
                background: Theme.surface;
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.item.text;
                        wrap: word-wrap;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                    }
                }
            }
        }

        if root.item.kind == 1 && root.item.reasoning != "" && (root.transcript-mode >= 1 || (root.item.streaming && root.item.text == "")): ThinkingBlock {
            text: root.item.reasoning;
            live: root.item.streaming && root.item.text == "";
            open: root.transcript-mode == 2;
        }

        if root.item.kind == 1: VerticalLayout {
            spacing: 10px;
            for s in root.item.segs: VerticalLayout {
                if s.kind == 0: Rectangle {
                    height: prose.preferred-height;
                    prose := StyledText {
                        width: parent.width;
                        text: s.md;
                        default-color: Theme.text;
                        default-font-size: Theme.fs-body;
                        default-font-family: Theme.ui-font;
                        link-color: Theme.link;
                    }
                }
                if s.kind == 1 || s.kind == 2: CodeBlock {
                    seg: s;
                    window-h: root.window-h;
                    copy(t) => { root.copy(t); }
                }
                if s.kind == 3: TableBlock { seg: s; }
                if s.kind == 4: Rectangle {
                    height: fence-prose.preferred-height;
                    fence-prose := StyledText {
                        width: parent.width;
                        text: s.md;
                        default-color: Theme.text;
                        default-font-size: Theme.fs-body;
                        default-font-family: Theme.ui-font;
                        link-color: Theme.link;
                    }
                }
            }
        }

        if root.item.kind == 2: ToolGroup {
            item: root.item;
            expanded: root.transcript-mode == 2;
        }

        if root.item.kind == 3: Rectangle {
            border-radius: Theme.r-md;
            background: root.item.error ? Theme.danger.with-alpha(0.10) : Theme.surface;
            border-width: 1px;
            border-color: root.item.error ? Theme.danger.with-alpha(0.4) : Theme.border;
            HorizontalLayout {
                padding: 10px;
                Text { text: root.item.text; wrap: word-wrap; color: root.item.error ? Theme.danger : Theme.text-2; font-size: Theme.fs-md; }
            }
        }
    }
}

export component Transcript inherits Rectangle {
    in property <[ChatRow]> rows;
    in property <string> status;
    in property <bool> running;
    in property <int> transcript-mode;
    in-out property <bool> follow: true;
    // Dev/measurement hook (HERMES_DESKTOP_AUTOSCROLL): sweep to the top and back to the
    // bottom once, ~7500 px/s, then clear the flag. Used by the long-transcript checks.
    in-out property <bool> autoscroll;
    property <int> sweep-dir: -1;
    callback copy(string);

    // Clipboard writes go through a hidden TextInput (Slint has no clipboard API).
    clipboard := TextInput { visible: false; width: 0; height: 0; }
    copy(t) => { clipboard.text = t; clipboard.select-all(); clipboard.copy(); clipboard.clear-selection(); }

    property <length> status-h: root.running ? 40px : 0px;
    list := ListView {
        width: root.width;
        height: root.height - root.status-h;
        // Stick to bottom while streaming unless the user scrolled up.
        scrolled => {
            root.follow = self.content-y <= self.visible-height - self.content-height + 40px;
        }
        for row in root.rows: MessageRow {
            item: row;
            column-w: Theme.column-w;
            window-h: root.height;
            transcript-mode: root.transcript-mode;
            copy(t) => { root.copy(t); }
        }
    }
    // Live status line under the list (ListView accepts a single `for` child).
    Rectangle {
            y: root.height - root.status-h;
            height: root.status-h;
            HorizontalLayout {
                x: (root.width - min(root.width - 48px, Theme.column-w)) / 2;
                width: min(root.width - 48px, Theme.column-w);
                spacing: 8px;
                alignment: start;
                if root.running: Image {
                    y: (parent.height - 18px) / 2;
                    width: 18px; height: 18px;
                    source: @image-url("../../../assets/icons/sparkles.svg");
                    colorize: Theme.accent;
                    // Restrained pulse.
                    opacity: Motion.reduce ? 1 : 0.55 + 0.45 * (0.5 + 0.5 * sin(animation-tick() / 900ms * 360deg));
                }
                if root.running: ShimmerText { text: root.status != "" ? root.status : "Thinking"; font-size: Theme.fs-md; }
            }
    }

    Timer {
        interval: 16ms;
        running: root.autoscroll;
        triggered => {
            if root.sweep-dir < 0 {
                list.content-y = min(0px, list.content-y + 120px);
                if list.content-y >= 0px { root.sweep-dir = 1; }
            } else {
                list.content-y = max(min(0px, list.visible-height - list.content-height), list.content-y - 120px);
                if list.content-y <= min(0px, list.visible-height - list.content-height) {
                    root.sweep-dir = -1;
                    root.autoscroll = false;
                }
            }
        }
    }

    // Keep the tail in view when new content arrives and follow is on.
    changed rows => { if root.follow { list.content-y = min(0px, list.visible-height - list.content-height); } }
    public function scroll-to-end() {
        root.follow = true;
        list.content-y = min(0px, list.visible-height - list.content-height);
    }
}

export struct CommandItem { text: string, label: string, detail: string }

export component Composer inherits Rectangle {
    in-out property <string> text;
    in property <bool> running;
    in property <bool> centered;
    in property <string> placeholder: "How can I help you today?";
    in property <string> model-label;
    in property <string> effort-label;
    in property <string> cwd-label;
    in property <[CommandItem]> completions;
    in property <int> queue-count;
    property <bool> dismissed;
    changed text => { root.dismissed = false; }
    callback inspect-queue();
    callback queue(string);
    callback send(string);
    callback stop();
    callback pick-model();
    callback pick-effort();
    callback pick-folder();
    callback attach();
    // Ctrl+V: the controller checks the clipboard for an image (text paste still happens).
    callback paste-image();
    // Images queued for the next message (chip labels); clicking a chip removes it.
    in property <[string]> attachments;
    callback remove-attachment(int);
    // Focus lands in the text input itself (the FocusScope around it only captures Enter).
    forward-focus: input;

    height: card.height + (centered ? 40px : 36px);

    card := Rectangle {
        y: 0;
        height: max(centered ? 112px : 56px, min(260px, input.preferred-height + (centered ? 68px : 30px)));
        animate height { duration: Motion.fast; easing: Ease.out; }
        border-radius: Theme.r-xl;
        background: Theme.raised;
        border-width: 1px;
        border-color: input.has-focus ? Theme.border-strong : Theme.border;
        animate border-color { duration: Motion.fast; }
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000055 : #0000001a;

        // Bare multi-line input inside the card. Enter sends, Shift+Enter inserts a newline.
        // In a conversation the card is one row: + on the left, send on the right, so the
        // text starts after the + button instead of underneath it.
        keys := FocusScope {
            x: root.centered ? 16px : 48px;
            y: 14px;
            width: parent.width - 32px - (root.centered ? 0px : 76px);
            height: parent.height - (root.centered ? 58px : 22px);
            capture-key-pressed(e) => {
                if e.modifiers.control && (e.text == "v" || e.text == "V") {
                    root.paste-image();
                    reject
                }
                if e.text == Key.Escape { root.dismissed = true; return reject; }
                if e.text == Key.Tab && root.completions.length > 0 && !root.dismissed {
                    root.text = root.completions[0].text;
                    root.dismissed = true;
                    return accept;
                }
                if e.text == Key.Return && !e.modifiers.shift {
                    if e.modifiers.control {
                        if root.text != "" { root.queue(root.text); }
                        return accept;
                    }
                    if root.text != "" { root.send(root.text); }
                    return accept;
                }
                reject
            }
            Flickable {
                content-height: max(self.height, input.preferred-height);
                input := TextInput {
                    width: parent.width;
                    height: max(keys.height, self.preferred-height);
                    text <=> root.text;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: Theme.fs-body;
                    font-family: Theme.ui-font;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    accessible-label: "Message";
                }
            }
            if root.text == "": Text {
                x: 0; y: 0;
                text: root.placeholder;
                font-size: Theme.fs-body;
                color: Theme.text-4;
            }
        }

        HorizontalLayout {
            x: 8px;
            y: parent.height - self.height - 8px;
            width: parent.width - 16px;
            height: 34px;
            spacing: 4px;
            IconButton {
                icon: @image-url("../../../assets/icons/plus.svg");
                tooltip: "Add files";
                clicked => { root.attach(); }
            }
            Rectangle { horizontal-stretch: 1; }
            send-btn := Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.r-md;
                property <bool> can-send: root.running || root.text != "";
                background: !can-send ? Theme.surface-2 : (send-ta.pressed ? Theme.accent.darker(15%) : send-ta.has-hover ? Theme.accent.darker(7%) : Theme.accent);
                animate background { duration: Motion.fast; }
                accessible-role: button;
                accessible-label: root.running ? "Stop" : "Send";
                accessible-action-default => { if root.running { root.stop(); } else { root.send(root.text); } }
                Image {
                    width: 16px; height: 16px;
                    source: root.running ? @image-url("../../../assets/icons/square.svg") : @image-url("../../../assets/icons/arrow-up.svg");
                    colorize: parent.can-send ? Theme.on-accent : Theme.text-4;
                }
                send-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { if root.running { root.stop(); } else if root.text != "" { root.send(root.text); } }
                }
            }
        }
    }

    if root.completions.length > 0 && !root.dismissed: Rectangle {
        y: -self.height - 6px;
        width: parent.width;
        height: min(240px, root.completions.length * 42px);
        background: Theme.raised;
        border-radius: Theme.r-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        clip: true;
        VerticalLayout {
            spacing: 0px;
            for c in root.completions: Rectangle {
                height: 42px;
                background: choice.has-hover ? Theme.hover : transparent;
                accessible-role: button;
                accessible-label: "Complete " + c.label;
                accessible-action-default => { root.text = c.text; root.dismissed = true; }
                VerticalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 0px;
                    Text { text: c.label; color: Theme.text; font-size: Theme.fs-md; overflow: elide; }
                    Text { text: c.detail; color: Theme.text-3; font-size: Theme.fs-sm; overflow: elide; }
                }
                choice := TouchArea { clicked => { root.text = c.text; root.dismissed = true; } }
            }
        }
    }

    // Chips row under the card.
    HorizontalLayout {
        y: card.height + 6px;
        height: 28px;
        spacing: 2px;
        padding-left: 6px;
        padding-right: 6px;
        Chip {
            text: root.cwd-label != "" ? root.cwd-label : "Project or folder";
            has-chevron: true;
            clicked => { root.pick-folder(); }
        }
        // Images queued for the next message; clicking one removes it.
        for name[i] in root.attachments: Chip {
            text: "📎 " + name + "  ✕";
            outlined: true;
            clicked => { root.remove-attachment(i); }
        }
        if root.queue-count > 0: Chip {
            text: "Queued: " + root.queue-count;
            clicked => { root.inspect-queue(); }
        }
        Rectangle { horizontal-stretch: 1; }
        Chip {
            text: root.model-label;
            clicked => { root.pick-model(); }
        }
        Chip {
            text: root.effort-label != "" ? root.effort-label : "Reasoning";
            has-chevron: true;
            clicked => { root.pick-effort(); }
        }
    }
}
