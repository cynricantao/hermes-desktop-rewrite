// Conversation column: virtualised transcript rows, tool-activity rows, composer.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, Motion, Ease } from "theme.slint";
import { Icon, IconButton, Chip, Spinner, ShimmerText } from "components.slint";

export struct ToolRow {
    name: string,
    context: string,
    // 0 running, 1 done, 2 failed
    state: int,
    summary: string,
    output: string,
    added: int,
    removed: int,
    duration: string,
}

export struct ChatRow {
    // 0 user, 1 assistant, 2 tools, 3 notice
    kind: int,
    text: string,
    md: styled-text,
    reasoning: string,
    streaming: bool,
    error: bool,
    tools: [ToolRow],
    // Group label, e.g. "Ran 3 commands" / "Edited 2 files"
    tools-label: string,
    tools-running: bool,
    tools-added: int,
    tools-removed: int,
}

// Collapsible "Ran 3 commands >" group. Expand animates height + chevron rotation.
component ToolGroup inherits Rectangle {
    in property <ChatRow> item;
    in-out property <bool> expanded: false;
    property <length> body-h: expanded ? body.preferred-height : 0px;
    height: header.height + self.body-h;
    clip: true;
    animate body-h { duration: Motion.slow; easing: Ease.out; }

    header := Rectangle {
        y: 0;
        height: 30px;
        border-radius: Theme.r-sm;
        background: hdr-ta.has-hover ? Theme.hover : transparent;
        animate background { duration: Motion.fast; }
        HorizontalLayout {
            padding-left: 6px;
            spacing: 8px;
            alignment: start;
            if root.item.tools-running: Spinner { y: (parent.height - 14px) / 2; size: 14px; }
            if !root.item.tools-running: Image {
                y: (parent.height - 15px) / 2;
                width: 15px; height: 15px;
                source: root.item.tools-added + root.item.tools-removed > 0
                    ? @image-url("../../../assets/icons/file-pen.svg")
                    : @image-url("../../../assets/icons/terminal.svg");
                colorize: Theme.text-3;
            }
            if root.item.tools-running: ShimmerText { text: root.item.tools-label; font-size: Theme.fs-md; }
            if !root.item.tools-running: Text { text: root.item.tools-label; font-size: Theme.fs-md; color: Theme.text-3; vertical-alignment: center; }
            if root.item.tools-added > 0: Text { text: "+" + root.item.tools-added; color: Theme.success; font-size: Theme.fs-sm; font-family: Theme.mono-font; vertical-alignment: center; }
            if root.item.tools-removed > 0: Text { text: "-" + root.item.tools-removed; color: Theme.danger; font-size: Theme.fs-sm; font-family: Theme.mono-font; vertical-alignment: center; }
            Image {
                y: (parent.height - 14px) / 2;
                width: 14px; height: 14px;
                source: @image-url("../../../assets/icons/chevron-right.svg");
                colorize: Theme.text-3;
                transform-origin: { x: 7px, y: 7px };
                transform-rotation: root.expanded ? 90deg : 0deg;
                animate transform-rotation { duration: Motion.base; easing: Ease.out; }
            }
        }
        hdr-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expanded = !root.expanded; }
        }
        accessible-role: button;
        accessible-label: root.item.tools-label;
        accessible-expandable: true;
        accessible-expanded: root.expanded;
        accessible-action-expand => { root.expanded = !root.expanded; }
    }

    body := VerticalLayout {
        y: header.height + 4px;
        width: root.width;
        padding-left: 12px;
        spacing: 6px;
        opacity: root.expanded ? 1 : 0;
        animate opacity { duration: Motion.base; }
        for t in root.item.tools: Rectangle {
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.code-bg;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 8px;
                    if t.state == 0: Spinner { size: 12px; cross-axis-self-alignment: center; }
                    Text {
                        text: (t.name == "terminal" ? "$ " : t.name + "  ") + t.context;
                        font-family: Theme.mono-font;
                        font-size: Theme.fs-sm;
                        color: t.state == 2 ? Theme.danger : Theme.text-2;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if t.added > 0: Text { text: "+" + t.added; color: Theme.success; font-size: Theme.fs-xs; font-family: Theme.mono-font; }
                    if t.removed > 0: Text { text: "-" + t.removed; color: Theme.danger; font-size: Theme.fs-xs; font-family: Theme.mono-font; }
                    Text { text: t.duration; font-size: Theme.fs-xs; color: Theme.text-4; }
                }
                if t.output != "": Text {
                    text: t.output;
                    font-family: Theme.mono-font;
                    font-size: Theme.fs-xs + 0.5px;
                    color: Theme.text-3;
                    wrap: char-wrap;
                    max-lines: 14;
                    overflow: elide;
                }
            }
        }
    }
}

component ThinkingBlock inherits Rectangle {
    in property <string> text;
    in property <bool> live;
    in-out property <bool> open: false;
    property <length> body-h: open ? body.preferred-height + 6px : 0px;
    height: 26px + body-h;
    clip: true;
    animate body-h { duration: Motion.slow; easing: Ease.out; }
    HorizontalLayout {
        height: 26px;
        y: 0;
        spacing: 6px;
        alignment: start;
        if root.live: ShimmerText { text: "Thinking"; font-size: Theme.fs-sm + 0.5px; }
        if !root.live: Text { text: "Thought process"; font-size: Theme.fs-sm + 0.5px; color: Theme.text-3; vertical-alignment: center; }
        Image {
            y: (parent.height - 12px) / 2;
            width: 12px; height: 12px;
            source: @image-url("../../../assets/icons/chevron-right.svg");
            colorize: Theme.text-3;
            transform-origin: { x: 6px, y: 6px };
            transform-rotation: root.open ? 90deg : 0deg;
            animate transform-rotation { duration: Motion.base; easing: Ease.out; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.open = !root.open; } }
    }
    body := Rectangle {
        y: 30px;
        x: 0;
        width: root.width;
        height: self.preferred-height;
        Rectangle { x: 0; width: 2px; background: Theme.border-strong; border-radius: 1px; }
        t := Text {
            x: 12px;
            width: parent.width - 12px;
            text: root.text;
            wrap: word-wrap;
            color: Theme.text-3;
            font-size: Theme.fs-md;
        }
        preferred-height: t.preferred-height;
    }
}

component MessageRow inherits Rectangle {
    in property <ChatRow> item;
    in property <int> transcript-mode; // 0 normal, 1 thinking, 2 verbose
    in property <length> column-w;
    callback copy(string);

    // Fade+rise on insert (list item animate-in).
    property <float> appear: 0;
    init => { appear = 1; }
    opacity: appear;
    animate opacity { duration: Motion.base; easing: Ease.out; }

    height: lay.preferred-height;
    lay := VerticalLayout {
        x: (root.width - min(root.width - 48px, root.column-w)) / 2;
        width: min(root.width - 48px, root.column-w);
        padding-top: root.item.kind == 0 ? 18px : 6px;
        padding-bottom: 6px;
        spacing: 6px;

        // User bubble: right-aligned, surface background.
        if root.item.kind == 0: HorizontalLayout {
            alignment: end;
            Rectangle {
                max-width: lay.width * 0.82;
                border-radius: Theme.r-lg;
                background: Theme.surface;
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 14px;
                    Text {
                        text: root.item.text;
                        wrap: word-wrap;
                        color: Theme.text;
                        font-size: Theme.fs-body;
                    }
                }
            }
        }

        if root.item.kind == 1 && root.item.reasoning != "" && (root.transcript-mode >= 1 || (root.item.streaming && root.item.text == "")): ThinkingBlock {
            text: root.item.reasoning;
            live: root.item.streaming && root.item.text == "";
            open: root.transcript-mode == 2;
        }

        if root.item.kind == 1 && root.item.text != "": Rectangle {
            height: prose.preferred-height;
            prose := StyledText {
                width: parent.width;
                text: root.item.md;
                default-color: Theme.text;
                default-font-size: Theme.fs-body;
                default-font-family: Theme.ui-font;
                link-color: Theme.link;
            }
        }

        if root.item.kind == 2: ToolGroup {
            item: root.item;
            expanded: root.transcript-mode == 2;
        }

        if root.item.kind == 3: Rectangle {
            border-radius: Theme.r-md;
            background: root.item.error ? Theme.danger.with-alpha(0.10) : Theme.surface;
            border-width: 1px;
            border-color: root.item.error ? Theme.danger.with-alpha(0.4) : Theme.border;
            HorizontalLayout {
                padding: 10px;
                Text { text: root.item.text; wrap: word-wrap; color: root.item.error ? Theme.danger : Theme.text-2; font-size: Theme.fs-md; }
            }
        }
    }
}

export component Transcript inherits Rectangle {
    in property <[ChatRow]> rows;
    in property <string> status;
    in property <bool> running;
    in property <int> transcript-mode;
    in-out property <bool> follow: true;
    // Dev/measurement hook (HERMES_DESKTOP_AUTOSCROLL): sweep to the top and back to the
    // bottom once, ~7500 px/s, then clear the flag. Used by the long-transcript checks.
    in-out property <bool> autoscroll;
    property <int> sweep-dir: -1;
    callback copy(string);

    property <length> status-h: root.running ? 40px : 0px;
    list := ListView {
        width: root.width;
        height: root.height - root.status-h;
        // Stick to bottom while streaming unless the user scrolled up.
        scrolled => {
            root.follow = self.content-y <= self.visible-height - self.content-height + 40px;
        }
        for row in root.rows: MessageRow {
            item: row;
            column-w: Theme.column-w;
            transcript-mode: root.transcript-mode;
            copy(t) => { root.copy(t); }
        }
    }
    // Live status line under the list (ListView accepts a single `for` child).
    Rectangle {
            y: root.height - root.status-h;
            height: root.status-h;
            HorizontalLayout {
                x: (root.width - min(root.width - 48px, Theme.column-w)) / 2;
                width: min(root.width - 48px, Theme.column-w);
                spacing: 8px;
                alignment: start;
                if root.running: Image {
                    y: (parent.height - 18px) / 2;
                    width: 18px; height: 18px;
                    source: @image-url("../../../assets/icons/sparkles.svg");
                    colorize: Theme.accent;
                    // Restrained pulse.
                    opacity: Motion.reduce ? 1 : 0.55 + 0.45 * (0.5 + 0.5 * sin(animation-tick() / 900ms * 360deg));
                }
                if root.running: ShimmerText { text: root.status != "" ? root.status : "Thinking"; font-size: Theme.fs-md; }
            }
    }

    Timer {
        interval: 16ms;
        running: root.autoscroll;
        triggered => {
            if root.sweep-dir < 0 {
                list.content-y = min(0px, list.content-y + 120px);
                if list.content-y >= 0px { root.sweep-dir = 1; }
            } else {
                list.content-y = max(min(0px, list.visible-height - list.content-height), list.content-y - 120px);
                if list.content-y <= min(0px, list.visible-height - list.content-height) {
                    root.sweep-dir = -1;
                    root.autoscroll = false;
                }
            }
        }
    }

    // Keep the tail in view when new content arrives and follow is on.
    changed rows => { if root.follow { list.content-y = min(0px, list.visible-height - list.content-height); } }
    public function scroll-to-end() {
        root.follow = true;
        list.content-y = min(0px, list.visible-height - list.content-height);
    }
}

export component Composer inherits Rectangle {
    in-out property <string> text;
    in property <bool> running;
    in property <bool> centered;
    in property <string> placeholder: "How can I help you today?";
    in property <string> model-label;
    in property <string> effort-label;
    in property <string> cwd-label;
    callback send(string);
    callback stop();
    callback pick-model();
    callback pick-effort();
    callback pick-folder();
    callback attach();
    // Focus lands in the text input itself (the FocusScope around it only captures Enter).
    forward-focus: input;

    height: card.height + (centered ? 40px : 36px);

    card := Rectangle {
        y: 0;
        height: max(centered ? 112px : 56px, min(260px, input.preferred-height + (centered ? 68px : 30px)));
        animate height { duration: Motion.fast; easing: Ease.out; }
        border-radius: Theme.r-xl;
        background: Theme.raised;
        border-width: 1px;
        border-color: input.has-focus ? Theme.border-strong : Theme.border;
        animate border-color { duration: Motion.fast; }
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.dark ? #00000055 : #0000001a;

        // Bare multi-line input inside the card. Enter sends, Shift+Enter inserts a newline.
        keys := FocusScope {
            x: 16px;
            y: 14px;
            width: parent.width - 32px - (root.centered ? 0px : 44px);
            height: parent.height - (root.centered ? 58px : 22px);
            capture-key-pressed(e) => {
                if e.text == Key.Return && !e.modifiers.shift {
                    if root.running { return accept; }
                    if root.text != "" { root.send(root.text); }
                    return accept;
                }
                reject
            }
            Flickable {
                content-height: max(self.height, input.preferred-height);
                input := TextInput {
                    width: parent.width;
                    height: max(keys.height, self.preferred-height);
                    text <=> root.text;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: Theme.fs-body;
                    font-family: Theme.ui-font;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    accessible-label: "Message";
                }
            }
            if root.text == "": Text {
                x: 0; y: 0;
                text: root.placeholder;
                font-size: Theme.fs-body;
                color: Theme.text-4;
            }
        }

        HorizontalLayout {
            x: 8px;
            y: parent.height - self.height - 8px;
            width: parent.width - 16px;
            height: 34px;
            spacing: 4px;
            IconButton {
                icon: @image-url("../../../assets/icons/plus.svg");
                tooltip: "Add files";
                cross-axis-self-alignment: center;
                clicked => { root.attach(); }
            }
            Rectangle { horizontal-stretch: 1; }
            send-btn := Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.r-md;
                property <bool> can-send: root.running || root.text != "";
                background: !can-send ? Theme.surface-2 : (send-ta.pressed ? Theme.accent.darker(15%) : send-ta.has-hover ? Theme.accent.darker(7%) : Theme.accent);
                animate background { duration: Motion.fast; }
                accessible-role: button;
                accessible-label: root.running ? "Stop" : "Send";
                accessible-action-default => { if root.running { root.stop(); } else { root.send(root.text); } }
                Image {
                    width: 16px; height: 16px;
                    source: root.running ? @image-url("../../../assets/icons/square.svg") : @image-url("../../../assets/icons/arrow-up.svg");
                    colorize: parent.can-send ? Theme.on-accent : Theme.text-4;
                }
                send-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { if root.running { root.stop(); } else if root.text != "" { root.send(root.text); } }
                }
            }
        }
    }

    // Chips row under the card.
    HorizontalLayout {
        y: card.height + 6px;
        height: 28px;
        spacing: 2px;
        padding-left: 6px;
        padding-right: 6px;
        Chip {
            text: root.cwd-label != "" ? root.cwd-label : "Project or folder";
            has-chevron: true;
            clicked => { root.pick-folder(); }
        }
        Rectangle { horizontal-stretch: 1; }
        Chip {
            text: root.model-label;
            clicked => { root.pick-model(); }
        }
        Chip {
            text: root.effort-label != "" ? root.effort-label : "Reasoning";
            has-chevron: true;
            clicked => { root.pick-effort(); }
        }
    }
}
