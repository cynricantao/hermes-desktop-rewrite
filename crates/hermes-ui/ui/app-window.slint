// Main window: titlebar strip, sidebar, conversation column, optional right panel, overlays.

import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, Motion, Ease, ThemeMode } from "theme.slint";
import { Icon, IconButton, NavItem, SectionHeader, Chip, Banner, Spinner, Toggle, Segmented, PrimaryButton, GhostButton } from "components.slint";
import { Transcript, Composer, ChatRow, ToolRow } from "chat.slint";
import { SettingsModal, SettingsState } from "settings.slint";

import { ProjectItem, ProjectState, ProjectsModal } from "projects.slint";

export { Theme, Motion, ThemeMode, ChatRow, ToolRow, SettingsState, ProjectItem, ProjectState }

export struct SessionItem {
    id: string,
    title: string,
    group: string,
    first-in-group: bool,
    pinned: bool,
    running: bool,
}

export struct ModelItem {
    provider: string,
    provider-name: string,
    model: string,
    current: bool,
    header: bool,
}

export struct ApprovalInfo {
    visible: bool,
    request-id: string,
    title: string,
    command: string,
    description: string,
    // Which choices the backend offered (params.choices); deny + once are always offered.
    allow-session: bool,
    allow-always: bool,
}

export global AppState {
    in-out property <string> user-name: "there";
    in-out property <string> greeting: "Up late";
    in-out property <string> connection: "connecting"; // connecting | open | error
    in-out property <string> connection-detail;
    in-out property <[SessionItem]> sessions;
    in-out property <string> active-session;
    in-out property <string> runtime-session;
    in-out property <string> session-title: "New chat";
    in-out property <[ChatRow]> rows;
    in-out property <bool> running;
    in-out property <string> status;
    in-out property <string> model-label: "Model";
    in-out property <string> effort-label;
    in-out property <[string]> effort-options: ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"];
    in-out property <string> cwd-label;
    in-out property <[ModelItem]> models;
    in-out property <string> banner;
    in-out property <bool> banner-error;
    in-out property <int> transcript-mode: 0;
    in-out property <ApprovalInfo> approval;
    in-out property <string> session-search;
    // Composer draft, shared by the hero and docked composers (Enter on an empty draft
    // answers an open approval card instead of being swallowed).
    in-out property <string> draft;
    changed draft => { AppState.save-draft(AppState.active-session, AppState.draft); }
    callback save-draft(string, string);
    in-out property <bool> autoscroll;

    callback send(string);
    callback stop();
    callback new-chat();
    callback open-session(string);
    callback delete-session(string);
    callback refresh-models();
    callback select-model(string, string);
    callback select-effort(string);
    callback approve(string, string);
    callback dismiss-banner();
    callback search-sessions(string);
    callback cycle-session(int);
}

component Sidebar inherits Rectangle {
    callback open-settings();
    background: Theme.sidebar-bg;
    clip: true;

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: Theme.titlebar-h + 4px;
        padding-bottom: 8px;
        spacing: 2px;

        // Search
        Rectangle {
            height: 32px;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: search.has-focus ? Theme.border-strong : Theme.border;
            background: Theme.bg.with-alpha(0.4);
            animate border-color { duration: Motion.fast; }
            HorizontalLayout {
                padding-left: 9px;
                spacing: 6px;
                Image { source: @image-url("../../../assets/icons/search.svg"); width: 14px; height: 14px; y: 9px; colorize: Theme.text-3; }
                search := TextInput {
                    text <=> AppState.session-search;
                    font-size: Theme.fs-md;
                    color: Theme.text;
                    vertical-alignment: center;
                    single-line: true;
                    accessible-label: "Search chats";
                    edited => { AppState.search-sessions(self.text); }
                    Text {
                        visible: parent.text == "";
                        text: "Search";
                        color: Theme.text-3;
                        font-size: Theme.fs-md;
                        vertical-alignment: center;
                        height: parent.height;
                        x: 0;
                    }
                }
            }
        }
        Rectangle { height: 6px; }
        NavItem {
            icon: @image-url("../../../assets/icons/plus.svg");
            text: "New chat";
            emphasized: true;
            clicked => { AppState.new-chat(); }
        }
        NavItem {
            icon: @image-url("../../../assets/icons/folder.svg");
            text: ProjectState.active-name != "" ? ProjectState.active-name : "Projects";
            clicked => { ProjectState.open = true; ProjectState.refresh(); }
        }
        NavItem { icon: @image-url("../../../assets/icons/box.svg"); text: "Artifacts"; clicked => { AppState.banner = "Artifact browsing is not available in this preview yet."; AppState.banner-error = false; } }
        NavItem { icon: @image-url("../../../assets/icons/clock.svg"); text: "Scheduled"; clicked => { AppState.banner = "Scheduled-job management is not available in this preview yet."; AppState.banner-error = false; } }
        NavItem { icon: @image-url("../../../assets/icons/sliders-horizontal.svg"); text: "Customize"; clicked => { root.open-settings(); } }

        Rectangle { height: 10px; }
        SectionHeader { text: "Recents"; }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 1px;
                for s in AppState.sessions: VerticalLayout {
                    if s.first-in-group: SectionHeader { text: s.group; height: 26px; }
                    item := NavItem {
                        has-icon: false;
                        text: s.title;
                        selected: s.id == AppState.active-session;
                        clicked => { AppState.open-session(s.id); }
                    }
                }
                if AppState.sessions.length == 0 && AppState.connection == "open": Text {
                    text: AppState.session-search != "" ? "No matching chats" : "No chats yet";
                    color: Theme.text-4;
                    font-size: Theme.fs-sm;
                    x: 10px;
                }
            }
        }

        // Footer: user + settings
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        HorizontalLayout {
            height: 44px;
            padding-left: 6px;
            spacing: 8px;
            Rectangle {
                y: 10px;
                width: 24px; height: 24px;
                border-radius: 12px;
                background: Theme.interactive.with-alpha(0.75);
                Text { text: AppState.user-name != "" ? AppState.user-name.character-count > 0 ? "H" : "H" : "H"; color: Theme.on-accent; font-size: Theme.fs-sm; font-weight: 600; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: AppState.user-name; color: Theme.text; font-size: Theme.fs-md; overflow: elide; }
                Text {
                    text: AppState.connection == "open" ? "Hermes · local" : AppState.connection == "error" ? "Disconnected" : "Connecting…";
                    color: AppState.connection == "error" ? Theme.danger : Theme.text-3;
                    font-size: Theme.fs-xs;
                }
            }
            IconButton {
                y: 7px;
                icon: @image-url("../../../assets/icons/settings.svg");
                tooltip: "Settings";
                clicked => { root.open-settings(); }
            }
        }
    }
}

component ModelPicker inherits Rectangle {
    in-out property <bool> open;
    property <float> t: open ? 1 : 0;
    animate t { duration: Motion.base; easing: Ease.out; }
    visible: t > 0.01;
    opacity: t;
    border-radius: Theme.r-lg;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000066;
    transform-origin: { x: self.width, y: self.height };
    transform-scale: 0.96 + 0.04 * t;
    ScrollView {
        x: 4px; y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        VerticalLayout {
            if AppState.models.length == 0: Text {
                text: "No models are available yet. Configure a provider in Hermes, then reopen this menu.";
                wrap: word-wrap; color: Theme.text-3;
            }
            for m in AppState.models: Rectangle {
                height: m.header ? 28px : 30px;
                accessible-role: button;
                accessible-label: m.header ? "Provider " + m.provider-name : "Use " + m.model;
                accessible-action-default => { if !m.header { AppState.select-model(m.provider, m.model); root.open = false; } }
                border-radius: Theme.r-sm;
                background: !m.header && ta.has-hover ? Theme.hover : transparent;
                animate background { duration: Motion.fast; }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: m.header ? m.provider-name : m.model;
                        color: m.header ? Theme.text-3 : Theme.text;
                        font-size: m.header ? Theme.fs-xs : Theme.fs-md;
                        font-weight: m.header ? 500 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if m.current: Image { source: @image-url("../../../assets/icons/check.svg"); width: 14px; height: 14px; y: 8px; colorize: Theme.interactive; }
                }
                ta := TouchArea {
                    enabled: !m.header;
                    mouse-cursor: pointer;
                    clicked => { AppState.select-model(m.provider, m.model); root.open = false; }
                }
            }
        }
    }
}

component ApprovalCard inherits Rectangle {
    border-radius: Theme.r-lg;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.warning.with-alpha(0.5);
    drop-shadow-blur: 20px;
    drop-shadow-color: #00000055;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Image {
                source: @image-url("../../../assets/icons/triangle-alert.svg");
                width: 16px; height: 16px;
                cross-axis-self-alignment: center;
                colorize: Theme.warning;
            }
            Text { text: AppState.approval.title; color: Theme.text; font-size: Theme.fs-md; font-weight: 600; }
        }
        if AppState.approval.description != "": Text { text: AppState.approval.description; color: Theme.text-2; wrap: word-wrap; font-size: Theme.fs-md; }
        Rectangle {
            border-radius: Theme.r-md;
            background: Theme.code-bg;
            height: cmd.preferred-height + 16px;
            cmd := Text { x: 10px; width: parent.width - 20px; text: AppState.approval.command; font-family: Theme.mono-font; font-size: Theme.fs-sm; color: Theme.text; wrap: char-wrap; }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Enter to allow once · Esc to deny";
                color: Theme.text-4;
                font-size: Theme.fs-xs;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            GhostButton { text: "Deny"; clicked => { AppState.approve(AppState.approval.request-id, "deny"); } }
            if AppState.approval.allow-always: GhostButton { text: "Always allow"; clicked => { AppState.approve(AppState.approval.request-id, "always"); } }
            if AppState.approval.allow-session: GhostButton { text: "Allow for session"; clicked => { AppState.approve(AppState.approval.request-id, "session"); } }
            PrimaryButton { text: "Allow once"; clicked => { AppState.approve(AppState.approval.request-id, "once"); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "Hermes";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.bg;
    default-font-family: Theme.ui-font;
    default-font-size: Theme.fs-md;

    in-out property <bool> sidebar-open: true;
    // The settings panel is a registry-driven overlay; its visibility lives in
    // SettingsState so the controller can drive it (dev hooks, tests) and load data
    // exactly when it opens.
    in-out property <bool> settings-open <=> SettingsState.open;
    changed settings-open => {
        if settings-open {
            SettingsState.opened();
        } else {
            SettingsState.closed();
        }
    }
    in-out property <bool> picker-open: false;
    in-out property <bool> effort-open: false;
    property <bool> empty: AppState.rows.length == 0;
    property <length> dock-h: 92px;

    callback quit();

    // Sidebar width animates; content reflows with it.
    property <length> sb-w: sidebar-open ? Theme.sidebar-w : 0px;
    animate sb-w { duration: Motion.slow; easing: Ease.in-out; }

    // Global shortcuts.
    keys := FocusScope {
        capture-key-pressed(e) => {
            if e.modifiers.control && (e.text == "n" || e.text == "N") { AppState.new-chat(); return accept; }
            if e.modifiers.control && e.text == "," { root.settings-open = true; return accept; }
            if e.modifiers.control && (e.text == "b" || e.text == "B") { root.sidebar-open = !root.sidebar-open; return accept; }
            if e.modifiers.control && (e.text == "q" || e.text == "Q") { root.quit(); return accept; }
            // Next / previous chat in sidebar order. Some backends report Shift+Tab as Backtab.
            if e.modifiers.control && e.text == Key.Backtab { AppState.cycle-session(-1); return accept; }
            if e.modifiers.control && e.text == Key.Tab { AppState.cycle-session(e.modifiers.shift ? -1 : 1); return accept; }
            if e.text == Key.Escape {
                if ProjectState.open { ProjectState.open = false; return accept; }
                if root.effort-open { root.effort-open = false; return accept; }
                if root.settings-open { root.settings-open = false; return accept; }
                if root.picker-open { root.picker-open = false; return accept; }
            }
            // Approval card keys (same as the Electron app's approval-keys.ts): Esc denies,
            // Enter on an empty composer allows once. Checked before Esc-to-Stop.
            if AppState.approval.visible && !root.settings-open && !e.modifiers.shift && !e.modifiers.control && !e.modifiers.alt {
                if e.text == Key.Escape { AppState.approve(AppState.approval.request-id, "deny"); return accept; }
                if e.text == Key.Return && AppState.draft == "" { AppState.approve(AppState.approval.request-id, "once"); return accept; }
            }
            if e.text == Key.Escape && AppState.running { AppState.stop(); return accept; }
            reject
        }

        sidebar := Sidebar {
            x: 0;
            y: 0;
            width: root.sb-w;
            height: root.height;
            open-settings => { root.settings-open = true; }
        }
        if root.sb-w > 0: Rectangle { x: root.sb-w - 1px; width: 1px; height: root.height; background: Theme.border; }

        main := Rectangle {
            x: root.sb-w;
            y: 0;
            width: root.width - root.sb-w;
            height: root.height;

            // Title strip
            HorizontalLayout {
                y: 0;
                height: Theme.titlebar-h;
                padding-left: 8px;
                padding-right: 10px;
                spacing: 6px;
                IconButton {
                    y: 5px;
                    icon: @image-url("../../../assets/icons/panel-left.svg");
                    tooltip: "Toggle sidebar (Ctrl+B)";
                    clicked => { root.sidebar-open = !root.sidebar-open; }
                }
                Text {
                    text: root.empty ? "" : AppState.session-title;
                    color: Theme.text-2;
                    font-size: Theme.fs-md;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if AppState.connection != "open": Chip {
                    y: 6px;
                    interactive: false;
                    outlined: true;
                    text: AppState.connection == "error" ? "Offline" : "Connecting";
                }
                if !root.empty: Segmented {
                    y: 4px;
                    width: 228px;
                    options: ["Normal", "Thinking", "Verbose"];
                    selected <=> AppState.transcript-mode;
                }
            }

            if AppState.banner != "": Banner {
                x: (parent.width - self.width) / 2;
                y: Theme.titlebar-h + 4px;
                width: min(parent.width - 48px, Theme.column-w);
                text: AppState.banner;
                error: AppState.banner-error;
                dismissed => { AppState.dismiss-banner(); }
            }

            // Empty state: serif greeting + centred composer.
            if root.empty: VerticalLayout {
                alignment: center;
                spacing: 22px;
                padding-bottom: 80px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 12px;
                    Image {
                        source: @image-url("../../../assets/icons/sparkles.svg");
                        width: 32px; height: 32px;
                        y: (parent.height - 32px) / 2;
                        colorize: Theme.accent;
                    }
                    Text {
                        text: AppState.greeting + ", " + AppState.user-name + "?";
                        font-family: Theme.serif-font;
                        font-size: Theme.fs-greet;
                        font-weight: 400;
                        color: Theme.text;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    hero := Composer {
                        init => { self.focus(); }
                        width: min(main.width - 64px, 672px);
                        centered: true;
                        text <=> AppState.draft;
                        running: AppState.running;
                        model-label: AppState.model-label;
                        effort-label: AppState.effort-label;
                        cwd-label: AppState.cwd-label;
                        send(t) => { AppState.send(t); self.text = ""; }
                        stop => { AppState.stop(); }
                        pick-model => { root.effort-open = false; root.picker-open = !root.picker-open; AppState.refresh-models(); }
                        pick-effort => { root.picker-open = false; root.effort-open = !root.effort-open; }
                        pick-folder => { ProjectState.open = true; ProjectState.refresh(); }
                        attach => { AppState.banner = "File attachments are not available in this preview yet. Include a local file path in your message."; AppState.banner-error = false; }
                    }
                }
            }

            if !root.empty: transcript := Transcript {
                y: Theme.titlebar-h;
                width: parent.width;
                height: parent.height - Theme.titlebar-h - root.dock-h - 8px;
                rows: AppState.rows;
                running: AppState.running;
                status: AppState.status;
                transcript-mode: AppState.transcript-mode;
                autoscroll <=> AppState.autoscroll;
            }
            if !root.empty: dock := Composer {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 8px;
                // The hero composer is destroyed when the first row appears; keep typing focus.
                init => { root.dock-h = self.height; self.focus(); }
                changed height => { root.dock-h = self.height; }
                width: min(parent.width - 48px, Theme.column-w);
                centered: false;
                placeholder: "Reply to Hermes…";
                text <=> AppState.draft;
                running: AppState.running;
                model-label: AppState.model-label;
                effort-label: AppState.effort-label;
                cwd-label: AppState.cwd-label;
                send(t) => { AppState.send(t); self.text = ""; }
                stop => { AppState.stop(); }
                pick-model => { root.effort-open = false; root.picker-open = !root.picker-open; AppState.refresh-models(); }
                pick-effort => { root.picker-open = false; root.effort-open = !root.effort-open; }
                pick-folder => { ProjectState.open = true; ProjectState.refresh(); }
                attach => { AppState.banner = "File attachments are not available in this preview yet. Include a local file path in your message."; AppState.banner-error = false; }
            }

            if AppState.approval.visible: ApprovalCard {
                x: (parent.width - self.width) / 2;
                // Above the docked composer and the 40 px live status line.
                y: parent.height - self.height - root.dock-h - 8px - 48px;
                width: min(parent.width - 48px, Theme.column-w);
            }

            if root.effort-open: TouchArea { clicked => { root.effort-open = false; } }
            if root.effort-open: Rectangle {
                width: 180px; height: 288px;
                x: parent.width - self.width - max(24px, (parent.width - Theme.column-w) / 2);
                y: parent.height - self.height - 54px;
                background: Theme.raised; border-radius: Theme.r-lg; border-width: 1px; border-color: Theme.border-strong;
                VerticalLayout {
                    padding: 6px; spacing: 2px;
                    for level in AppState.effort-options: NavItem {
                        has-icon: false; text: level; selected: level == AppState.effort-label;
                        clicked => { AppState.select-effort(level); root.effort-open = false; }
                    }
                }
            }

            // Click-away for the picker.
            if root.picker-open: TouchArea { clicked => { root.picker-open = false; } }
            ModelPicker {
                open <=> root.picker-open;
                width: 320px;
                height: min(420px, parent.height - 120px);
                x: parent.width - self.width - max(24px, (parent.width - Theme.column-w) / 2);
                y: parent.height - self.height - 54px;
            }
        }

        ProjectsModal { width: root.width; height: root.height; }

        SettingsModal {
            width: root.width;
            height: root.height;
        }
    }
}
