// Icon lookup by name for registry-driven UI (settings nav, page rows, menus, the kit).
// Names are the Lucide file names under assets/icons (ISC, see LICENSE-lucide.txt),
// restyled to a 1.5 stroke (docs/DESIGN.md §9). Images are compiled in at build time;
// unknown names fall back to `circle`. Regenerate the list when adding an icon file.

export global Icons {
    public pure function get(name: string) -> image {
        if name == "app-window" { return @image-url("../../../assets/icons/app-window.svg"); }
        if name == "archive" { return @image-url("../../../assets/icons/archive.svg"); }
