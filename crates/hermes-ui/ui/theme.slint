// Design tokens. Values follow docs/DESIGN.md §5/§8/§10 (CDS token ladder, warm neutral).
// Every animation duration goes through Motion so "reduce motion" zeroes them in one place.

import "../../../assets/fonts/Inter.ttf";
import "../../../assets/fonts/SourceSerif4.ttf";
import "../../../assets/fonts/JetBrainsMono.ttf";

export enum ThemeMode { system, light, dark }

export global Theme {
    in-out property <ThemeMode> mode: ThemeMode.system;
    in-out property <bool> system-dark: true;
    out property <bool> dark: mode == ThemeMode.dark || (mode == ThemeMode.system && system-dark);

    // Palette. "" / "nous" is the default look (the values below, unchanged); the four
    // names below are the desktop presets this client can render locally (midnight, ember,
    // mono, cyberpunk — the ones shared with the Electron desktop). Any other name keeps the
    // default tokens: the backend still switches the dashboard theme, this window just has no
    // local palette for it. Set by `widgets::appearance::apply_pref` from the device pref.
    in-out property <string> palette: "nous";
    property <bool> pal-midnight: palette == "midnight";
    property <bool> pal-ember: palette == "ember";
    property <bool> pal-mono: palette == "mono";
    property <bool> pal-cyberpunk: palette == "cyberpunk";

    // Surfaces
    out property <color> bg:
        pal-midnight ? (dark ? #08081c : #f6f5fc)
      : pal-ember ? (dark ? #160800 : #fdf7f0)
      : pal-mono ? (dark ? #0e0e0e : #fafafa)
      : pal-cyberpunk ? (dark ? #000a00 : #eef7ec)
      : (dark ? #151515 : #fcfcfb);
    out property <color> sidebar-bg:
        pal-midnight ? (dark ? #06061a : #f1f0fa)
      : pal-ember ? (dark ? #100600 : #fbf1e7)
      : pal-mono ? (dark ? #0a0a0a : #f6f6f6)
      : pal-cyberpunk ? (dark ? #000600 : #e7f2e4)
      : (dark ? #111111 : #fbfbf9);
    out property <color> surface:
        pal-midnight ? (dark ? #0d0d28 : #ffffff)
      : pal-ember ? (dark ? #1e0e04 : #ffffff)
      : pal-mono ? (dark ? #141414 : #ffffff)
      : pal-cyberpunk ? (dark ? #001200 : #ffffff)
      : (dark ? #20201f : #ffffff);
    out property <color> surface-2:
        pal-midnight ? (dark ? #13133a : #eceaf7)
      : pal-ember ? (dark ? #2a1408 : #f7ece0)
      : pal-mono ? (dark ? #1e1e1e : #f0f0f0)
      : pal-cyberpunk ? (dark ? #001a00 : #dcefda)
      : (dark ? #2c2c2a : #f0efec);
    out property <color> raised:
        pal-midnight ? (dark ? #0d0d28 : #ffffff)
      : pal-ember ? (dark ? #1e0e04 : #ffffff)
      : pal-mono ? (dark ? #141414 : #ffffff)
      : pal-cyberpunk ? (dark ? #001200 : #ffffff)
      : (dark ? #20201f : #ffffff);
    out property <color> hover:         dark ? #ffffff0d : #0b0b0b0d;
    out property <color> pressed:       dark ? #ffffff1a : #0b0b0b1a;
    out property <color> selected:      dark ? #ffffff1a : #0b0b0b1a;
    out property <color> scrim:         dark ? #00000080 : #00000066;

    // Borders
    out property <color> border:
        pal-midnight ? (dark ? #1e1e52 : #ddd9ef)
      : pal-ember ? (dark ? #3a1c08 : #ecdcc9)
      : pal-mono ? (dark ? #2a2a2a : #e3e3e3)
      : pal-cyberpunk ? (dark ? #003000 : #c9e2c6)
      : (dark ? #ffffff1a : #0b0b0b1a);
    out property <color> border-strong:
        pal-midnight ? (dark ? #2b2b6e : #c6c0e4)
      : pal-ember ? (dark ? #552a10 : #dcc4a6)
      : pal-mono ? (dark ? #3d3d3d : #c9c9c9)
      : pal-cyberpunk ? (dark ? #005000 : #a9d2a4)
      : (dark ? #ffffff33 : #0b0b0b33);

    // Text
    out property <color> text:          dark ? #f0efec : #0b0b0b;
    out property <color> text-2:        dark ? #c3c2b7 : #3d3d3a;
    out property <color> text-3:        dark ? #898781 : #73726c;
    out property <color> text-4:        dark ? #6d6b67 : #a5a49a;

    // Accent & semantic
    out property <color> accent:
        pal-midnight ? (dark ? #8b80e8 : #6d5fd0)
      : pal-ember ? (dark ? #d97316 : #c1502a)
      : pal-mono ? (dark ? #9a9a9a : #5f5f5f)
      : pal-cyberpunk ? (dark ? #00ff41 : #0f8f2f)
      : (dark ? #d97757 : #d97757);
    out property <color> accent-soft:
        pal-midnight ? (dark ? #8b80e82e : #6d5fd024)
      : pal-ember ? (dark ? #d973162e : #c1502a24)
      : pal-mono ? (dark ? #9a9a9a2e : #5f5f5f24)
      : pal-cyberpunk ? (dark ? #00ff412e : #0f8f2f24)
      : (dark ? #d977572e : #d9775724);
    out property <color> on-accent:     #ffffff;
    // Interactive blue (toggles, focus, primary buttons); clay above is brand-only.
    out property <color> interactive:
        pal-midnight ? (dark ? #8b80e8 : #6d5fd0)
      : pal-ember ? (dark ? #d97316 : #c1502a)
      : pal-mono ? (dark ? #9a9a9a : #5f5f5f)
      : pal-cyberpunk ? (dark ? #00ff41 : #0f8f2f)
      : #2a78d6;
    out property <color> toggle-on:
        pal-midnight ? (dark ? #8b80e8 : #6d5fd0)
      : pal-ember ? (dark ? #d97316 : #c1502a)
      : pal-mono ? (dark ? #9a9a9a : #5f5f5f)
      : pal-cyberpunk ? (dark ? #00ff41 : #0f8f2f)
      : (dark ? #2a78d6 : #2a78d6);
    out property <color> link:          dark ? #74abe2 : #1b67b2;
    out property <color> success:       dark ? #55bf50 : #1e9e3c;
    out property <color> danger:        dark ? #ec7e7e : #cd2054;
    out property <color> warning:       dark ? #fab219 : #98801f;
    out property <color> diff-add-bg:   dark ? #32d74b33 : #1e9e3c33;
    out property <color> diff-del-bg:   dark ? #ff2c5633 : #cd205433;
    out property <color> diff-add-fg:   dark ? #32d74b : #1e9e3c;
    out property <color> diff-del-fg:   dark ? #ff2c56 : #cd2054;
    out property <color> code-bg:
        pal-midnight ? (dark ? #0b0b22 : #f4f2fb)
      : pal-ember ? (dark ? #1a0b02 : #fbf3ea)
      : pal-mono ? (dark ? #111111 : #f5f5f5)
      : pal-cyberpunk ? (dark ? #000d00 : #eaf5e7)
      : (dark ? #1a1a19 : #f9f9f7);

    // Typography
    in-out property <string> ui-font: "Inter";
    out property <string> serif-font: "Source Serif 4";
    in-out property <string> mono-font: "JetBrains Mono";
    out property <length> fs-xs: 11px;
    out property <length> fs-sm: 12.5px;
    out property <length> fs-md: 14px;
    out property <length> fs-body: 15.5px;
    out property <length> fs-lg: 17px;
    out property <length> fs-greet: 38px;

    // Radii
    out property <length> r-xs: 4px;   // skeleton / tiny
    out property <length> r-sm: 6px;   // chips
    out property <length> r-md: 8px;   // controls, rows
    out property <length> r-lg: 12px;  // panels, modals, cards
    out property <length> r-xl: 14px;  // composer (comfortable density)
    out property <length> r-pill: 999px;

    // Layout
    out property <length> sidebar-w: 288px;
    out property <length> titlebar-h: 36px;
    out property <length> column-w: 768px;
    out property <length> right-panel-w: 288px;
}

export global Motion {
    in-out property <bool> reduce: false;
    out property <duration> fast:   reduce ? 0ms : 120ms;   // --cds-dur-snap: hover / press colour
    out property <duration> base:   reduce ? 0ms : 200ms;   // --cds-dur-base: modal in, expand, chevron
    out property <duration> exit:   reduce ? 0ms : 150ms;   // modal out
    out property <duration> slow:   reduce ? 0ms : 300ms;   // --cds-dur-sheet: sidebar / right panel
}

// Easings live in their own global (not re-exported to Rust: easing is not a public API type).
export global Ease {
    out property <easing> out:      cubic-bezier(0.165, 0.84, 0.44, 1);   // --cds-ease-out
    out property <easing> in-out:   cubic-bezier(0.165, 0.84, 0.44, 1);   // sheets use ease-out too
    out property <easing> standard: cubic-bezier(0.32, 0.72, 0, 1);      // --cds-ease-snap
}
