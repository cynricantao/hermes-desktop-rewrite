// Reusable primitives. Every interactive element animates colour with Motion.fast and
// geometry with Motion.base/slow so reduce-motion collapses all of them at once.

import { Theme, Motion, Ease } from "theme.slint";

export component Icon inherits Image {
    in property <length> size: 16px;
    width: size;
    height: size;
    colorize: Theme.text-2;
    image-fit: contain;
}

export component Spinner inherits Rectangle {
    in property <length> size: 14px;
    in property <color> tint: Theme.text-3;
    width: size;
    height: size;
    // Rotates continuously only while visible; animation-tick() drives repaint at display rate.
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("../../../assets/icons/loader-circle.svg");
        colorize: root.tint;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: Motion.reduce ? 0deg : mod(animation-tick() / 2.2ms, 360) * 1deg;
    }
}

// Text with a soft travelling highlight — used for "Thinking", running tool rows.
export component ShimmerText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Theme.fs-md;
    in property <color> base: Theme.text-3;
    in property <bool> active: true;
    preferred-width: label.preferred-width;
    height: label.preferred-height;
    // 0..1 phase over 1.6s; with reduce-motion we fall back to a gentle opacity pulse = none.
    property <float> phase: (active && !Motion.reduce) ? mod(animation-tick() / 1600ms, 1.0) : 0;
    label := Text {
        text: root.text;
        font-size: root.font-size;
        font-family: Theme.ui-font;
        color: root.base;
        vertical-alignment: center;
    }
    if root.active && !Motion.reduce: Text {
        text: root.text;
        font-size: root.font-size;
        font-family: Theme.ui-font;
        vertical-alignment: center;
        color: transparent;
        stroke: @linear-gradient(90deg,
            transparent 0%,
            transparent max(0%, (root.phase * 1.6 - 0.4) * 100%),
            Theme.text 0%,
            transparent min(100%, (root.phase * 1.6 + 0.1) * 100%));
        stroke-width: 0px;
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 16px;
    in property <bool> active: false;
    in property <string> tooltip;
    in property <color> tint: active ? Theme.text : Theme.text-3;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: Theme.r-sm;
    background: ta.pressed ? Theme.pressed : (ta.has-hover || active) ? Theme.hover : transparent;
    animate background { duration: Motion.fast; easing: Ease.standard; }
    accessible-role: button;
    accessible-label: tooltip;
    accessible-action-default => { root.clicked(); }
    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: ta.has-hover ? Theme.text : root.tint;
        animate colorize { duration: Motion.fast; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Sidebar navigation row ("New", "Projects", a session …).
export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> text;
    in property <string> badge;
    in property <bool> selected: false;
    in property <bool> emphasized: false;
    in property <bool> dim: false;
    callback clicked();
    height: 32px;
    border-radius: Theme.r-md;
    background: ta.pressed ? Theme.pressed : selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.fast; easing: Ease.standard; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        alignment: start;
        if root.has-icon: Image {
            source: root.icon;
            width: 16px;
            colorize: root.selected || root.emphasized ? Theme.text : Theme.text-2;
            y: (parent.height - 16px) / 2;
            height: 16px;
        }
        Text {
            text: root.text;
            font-size: Theme.fs-md;
            font-weight: root.emphasized ? 500 : 400;
            color: root.dim ? Theme.text-3 : (root.selected || root.emphasized ? Theme.text : Theme.text-2);
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.badge != "": Rectangle {
            y: (parent.height - 18px) / 2;
            height: 18px;
            width: badge-text.preferred-width + 10px;
            border-radius: Theme.r-xs;
            background: Theme.surface-2;
            badge-text := Text { text: root.badge; font-size: Theme.fs-xs; color: Theme.text-3; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SectionHeader inherits Rectangle {
    in property <string> text;
    height: 30px;
    Text {
        x: 10px;
        text: root.text;
        font-size: Theme.fs-sm;
        color: Theme.text-3;
        vertical-alignment: center;
        height: parent.height;
    }
}

// Pill / chip — model picker, mode chips, status chips.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> secondary;
    in property <bool> outlined: false;
    in property <bool> interactive: true;
    in property <bool> has-chevron: false;
    callback clicked();
    height: 28px;
    width: row.preferred-width;
    border-radius: Theme.r-sm;
    border-width: outlined ? 1px : 0px;
    border-color: Theme.border;
    background: interactive && ta.pressed ? Theme.pressed : interactive && ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.fast; }
    accessible-role: button;
    accessible-label: text + " " + secondary;
    accessible-action-default => { root.clicked(); }
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        Text { text: root.text; font-size: Theme.fs-sm; font-weight: 500; color: Theme.text-2; vertical-alignment: center; }
        if root.secondary != "": Text { text: root.secondary; font-size: Theme.fs-sm; color: Theme.text-3; vertical-alignment: center; }
        if root.has-chevron: Image {
            source: @image-url("../../../assets/icons/chevron-down.svg");
            width: 12px; height: 12px; y: (parent.height - 12px) / 2;
            colorize: Theme.text-3;
        }
    }
    ta := TouchArea {
        enabled: root.interactive;
        mouse-cursor: root.interactive ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    callback clicked();
    height: 32px;
    width: max(72px, label.preferred-width + 28px);
    border-radius: Theme.r-md;
    // CDS "fill primary": neutral ink on the page (white in dark, near-black in light).
    background: !enabled ? Theme.surface-2 : danger ? Theme.danger : (ta.pressed ? Theme.text.transparentize(25%) : ta.has-hover ? Theme.text.transparentize(12%) : Theme.text);
    animate background { duration: Motion.fast; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    label := Text { text: root.text; color: root.enabled ? (root.danger ? Theme.on-accent : Theme.bg) : Theme.text-4; font-size: Theme.fs-md; font-weight: 500; }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 32px;
    width: max(64px, label.preferred-width + 24px);
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.fast; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { root.clicked(); }
    label := Text { text: root.text; color: Theme.text; font-size: Theme.fs-md; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    width: 36px;
    height: 20px;
    border-radius: 10px;
    background: checked ? Theme.toggle-on : Theme.border-strong;
    animate background { duration: Motion.base; easing: Ease.standard; }
    accessible-role: switch;
    accessible-checked: checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(root.checked); }
    knob := Rectangle {
        width: 16px;
        height: 16px;
        y: 2px;
        x: root.checked ? root.width - self.width - 2px : 2px;
        border-radius: 8px;
        background: #ffffff;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
        animate x { duration: Motion.base; easing: Ease.out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
}

// Segmented control: "Normal | Thinking | Verbose", "Light | Dark | System" …
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: 32px;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.bg;
    property <length> seg-w: (self.width - 4px) / max(1, options.length);
    preferred-width: options.length * 92px;
    // Sliding selection pill.
    Rectangle {
        x: 2px + root.selected * root.seg-w;
        y: 2px;
        width: root.seg-w;
        height: root.height - 4px;
        border-radius: Theme.r-sm;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border;
        animate x { duration: Motion.base; easing: Ease.out; }
    }
    for opt[i] in root.options: Rectangle {
        x: 2px + i * root.seg-w;
        width: root.seg-w;
        height: root.height;
        accessible-role: tab;
        accessible-label: opt;
        accessible-item-selected: i == root.selected;
        accessible-action-default => { root.selected = i; root.changed(i); }
        Text {
            text: opt;
            font-size: Theme.fs-sm + 0.5px;
            color: i == root.selected ? Theme.text : Theme.text-3;
            animate color { duration: Motion.fast; }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; root.changed(i); } }
    }
}

export component Banner inherits Rectangle {
    in property <string> text;
    in property <bool> error: false;
    callback dismissed();
    height: row.preferred-height;
    border-radius: Theme.r-md;
    border-width: 1px;
    border-color: error ? Theme.danger.with-alpha(0.45) : Theme.warning.with-alpha(0.4);
    background: error ? Theme.danger.with-alpha(0.10) : Theme.warning.with-alpha(0.08);
    row := HorizontalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 10px;
        Image {
            source: @image-url("../../../assets/icons/triangle-alert.svg");
            width: 16px;
            height: 16px;
            colorize: root.error ? Theme.danger : Theme.warning;
        }
        Text { text: root.text; color: Theme.text-2; font-size: Theme.fs-md; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
        IconButton {
            width: 22px; height: 22px;
            icon: @image-url("../../../assets/icons/x.svg");
            icon-size: 14px;
            tooltip: "Dismiss";
            clicked => { root.dismissed(); }
        }
    }
}
