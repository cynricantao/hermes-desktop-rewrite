// Settings modal: fades + scales in (Motion.base, ease-out), left nav + scrolling sections.

import { ScrollView, LineEdit } from "std-widgets.slint";
import { Theme, Motion, Ease, ThemeMode } from "theme.slint";
import { IconButton, Toggle, Segmented } from "components.slint";

export global SettingsState {
    in-out property <int> page: 0;
    in-out property <int> theme-mode: 0; // 0 system 1 light 2 dark
    in-out property <bool> reduce-motion: false;
    in-out property <int> transcript-default: 0;
    in-out property <int> ui-font: 0; // 0 Inter 1 System
    in-out property <string> code-font: "JetBrains Mono";
    in-out property <bool> show-reasoning: true;
    in-out property <bool> yolo: false;
    in-out property <string> backend-version;
    in-out property <string> hermes-home;
    callback changed(string, string);
}

component NavRow inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <int> index;
    height: 32px;
    border-radius: Theme.r-md;
    background: SettingsState.page == index ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Motion.fast; }
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selected: SettingsState.page == index;
    accessible-action-default => { SettingsState.page = index; }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        Image { source: root.icon; width: 16px; height: 16px; y: 8px; colorize: SettingsState.page == root.index ? Theme.text : Theme.text-2; }
        Text { text: root.text; color: SettingsState.page == root.index ? Theme.text : Theme.text-2; font-size: Theme.fs-md; vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { SettingsState.page = root.index; } }
}

export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    min-height: lay.preferred-height;
    lay := HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            Text { text: root.title; color: Theme.text; font-size: Theme.fs-md + 0.5px; }
            if root.description != "": Text { text: root.description; color: Theme.text-3; font-size: Theme.fs-sm + 0.5px; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center; @children }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
}

export component SectionTitle inherits Text {
    color: Theme.text;
    font-size: Theme.fs-lg - 1px;
    font-weight: 600;
}

export component SettingsModal inherits Rectangle {
    in-out property <bool> open;
    property <float> t: open ? 1 : 0;
    animate t { duration: open ? Motion.base : Motion.exit; easing: Ease.standard; }
    visible: t > 0.001;

    // Scrim
    Rectangle {
        background: Theme.scrim;
        opacity: root.t;
        TouchArea { clicked => { root.open = false; } }
    }

    card := Rectangle {
        width: min(root.width - 80px, 1000px);
        height: min(root.height - 80px, 720px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        opacity: root.t;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-scale: 0.98 + 0.02 * root.t;
        border-radius: Theme.r-lg;
        background: Theme.bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000080;
        clip: true;
        TouchArea {} // swallow clicks so they don't close the modal

        HorizontalLayout {
            // Left nav
            Rectangle {
                width: 192px;
                background: Theme.sidebar-bg;
                VerticalLayout {
                    padding: 12px;
                    spacing: 2px;
                    Text { text: "Settings"; color: Theme.text-3; font-size: Theme.fs-sm; height: 28px; vertical-alignment: center; x: 10px; }
                    NavRow { index: 0; text: "General"; icon: @image-url("../../../assets/icons/settings.svg"); }
                    NavRow { index: 1; text: "Appearance"; icon: @image-url("../../../assets/icons/sun.svg"); }
                    NavRow { index: 2; text: "Models"; icon: @image-url("../../../assets/icons/brain.svg"); }
                    NavRow { index: 3; text: "Tools & approvals"; icon: @image-url("../../../assets/icons/wrench.svg"); }
                    NavRow { index: 4; text: "About"; icon: @image-url("../../../assets/icons/sparkles.svg"); }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }
            // Content
            Rectangle {
                horizontal-stretch: 1;
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 32px;
                        padding-top: 28px;
                        spacing: 4px;

                        if SettingsState.page == 0: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            SectionTitle { text: "General"; }
                            SettingRow {
                                title: "Show reasoning";
                                description: "Stream the model's thinking into a collapsible block above each reply.";
                                Toggle { checked <=> SettingsState.show-reasoning; toggled(v) => { SettingsState.changed("show_reasoning", v ? "true" : "false"); } }
                            }
                            SettingRow {
                                title: "Default transcript view";
                                description: "Normal hides thinking, Thinking shows it collapsed, Verbose expands tool output.";
                                Segmented { width: 240px; options: ["Normal", "Thinking", "Verbose"]; selected <=> SettingsState.transcript-default; changed(i) => { SettingsState.changed("transcript_default", i); } }
                            }
                        }
                        if SettingsState.page == 1: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            SectionTitle { text: "Appearance"; }
                            SettingRow {
                                title: "Theme";
                                description: "Follow the system colour scheme or pick one.";
                                Segmented { width: 240px; options: ["System", "Light", "Dark"]; selected <=> SettingsState.theme-mode; changed(i) => { SettingsState.changed("theme", i); } }
                            }
                            SettingRow {
                                title: "Interface font";
                                description: "Font for menus, sidebars and panels.";
                                Segmented { width: 200px; options: ["Inter", "System"]; selected <=> SettingsState.ui-font; changed(i) => { SettingsState.changed("ui_font", i); } }
                            }
                            SettingRow {
                                title: "Code font";
                                description: "Monospace font for code and terminal output.";
                                LineEdit { width: 220px; text <=> SettingsState.code-font; edited(t) => { SettingsState.changed("code_font", t); } }
                            }
                            SettingRow {
                                title: "Reduce motion";
                                description: "Turn off non-essential animation (also follows the system setting).";
                                Toggle { checked <=> SettingsState.reduce-motion; toggled(v) => { SettingsState.changed("reduce_motion", v ? "true" : "false"); } }
                            }
                        }
                        if SettingsState.page == 2: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            SectionTitle { text: "Models"; }
                            SettingRow { title: "Pick a model from the composer chip."; description: "Provider setup and defaults are added in the settings phase (see PARITY.md)."; }
                        }
                        if SettingsState.page == 3: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            SectionTitle { text: "Tools & approvals"; }
                            SettingRow {
                                title: "Auto-approve dangerous commands (YOLO)";
                                description: "Skip approval prompts for this session.";
                                Toggle { checked <=> SettingsState.yolo; toggled(v) => { SettingsState.changed("yolo", v ? "true" : "false"); } }
                            }
                        }
                        if SettingsState.page == 4: VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            SectionTitle { text: "About"; }
                            SettingRow { title: "Hermes backend"; description: SettingsState.backend-version; }
                            SettingRow { title: "Hermes home"; description: SettingsState.hermes-home; }
                            SettingRow { title: "Licences"; description: "Inter, Source Serif 4 and JetBrains Mono (SIL OFL 1.1); Lucide icons (ISC). Built with Slint."; }
                        }
                    }
                }
                IconButton {
                    x: parent.width - self.width - 14px;
                    y: 14px;
                    icon: @image-url("../../../assets/icons/x.svg");
                    tooltip: "Close settings";
                    clicked => { root.open = false; }
                }
            }
        }
    }
}
