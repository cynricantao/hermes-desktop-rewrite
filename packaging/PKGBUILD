# Maintainer: cynricantao <cynricantao@pm.me>
# Builds from the local checkout:  cd packaging && makepkg -si
pkgname=hermes-desktop-rs
pkgver=0.1.0
pkgrel=1
pkgdesc="Native Rust (Slint) desktop client for Hermes Agent"
arch=('x86_64' 'aarch64')
url="https://github.com/cynricantao/hermes-desktop-rewrite"
license=('MIT')
depends=('fontconfig' 'freetype2' 'libxkbcommon' 'wayland' 'libglvnd' 'gcc-libs')
makedepends=('cargo')
optdepends=('hermes-agent: the backend (the `hermes` CLI must be on PATH)')
options=('!lto')
source=()

_root() { realpath "$startdir/.."; }

prepare() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p hermes-app
}

check() {
  cd "$(_root)"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --workspace
}

package() {
  local root; root="$(_root)"
  install -Dm755 "$srcdir/target/release/hermes-desktop-rs" "$pkgdir/usr/bin/hermes-desktop-rs"
  install -Dm644 "$root/packaging/hermes-desktop-rs.desktop" "$pkgdir/usr/share/applications/hermes-desktop-rs.desktop"
  install -Dm644 "$root/packaging/hermes-desktop-rs.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hermes-desktop-rs.svg"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$root/assets/fonts/"*-OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname/fonts/"
  install -Dm644 "$root/assets/icons/LICENSE-lucide.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-lucide.txt"
}
