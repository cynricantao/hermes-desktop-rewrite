# Keep shell scripts and packaging files LF so they run on the runners that
# build the releases (see docs/RELEASING.md).
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.slint text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
PKGBUILD text eol=lf
*.ps1 text eol=crlf
*.md text eol=lf

*.png binary
*.jpg binary
*.ttf binary
*.icns binary
*.dmg binary
*.zst binary
